  "_readme": [
    "shadcn 상류 대비 차이 기록 (#48).",
    "이 레포의 components/ui/ 는 '손대지 않은 shadcn 원본' 이 아니라 하우스 스타일이 적용된 포크다.",
    "60개 중 56개가 상류와 의미 있게 다르다. 규칙의 '수정 금지' 는 '임의로 더 고치지 말고,",
    "기록된 차이를 되돌리지도 말라' 는 뜻으로 읽어야 한다.",
    "점검: node scripts/shadcn-upstream.mjs (네트워크 사용, 수동 게이트)",
    "갱신: node scripts/shadcn-upstream.mjs --update"
  ],
  "houseStyle": {
    "controlScale": {
      "what": "컨트롤 높이·좌우 패딩을 상류보다 한 단계 작게 쓴다 (예: 버튼 default h-9→h-8, input h-9→h-8, px-3→px-2.5).",
      "why": "#43 의 밀도(density) 축이 이 값을 기준으로 28/32/36px 비례를 계산한다. 상류 값으로 되돌리면 밀도 축 수치가 어긋난다.",
      "examples": [
        "button.tsx",
        "input.tsx",
        "tabs.tsx",
        "toggle.tsx",
        "select.tsx"
      ]
    },
    "radiusTokens": {
      "what": "상류의 고정 rounded-md 대신 --radius 파생 토큰을 쓴다 (예: rounded-[min(var(--radius-md),12px)]).",
      "why": "#43 의 모서리(corner) 축이 프로필별로 반경을 바꾸려면 컴포넌트가 토큰을 참조해야 한다. 고정값이면 축이 닿지 않는다.",
      "examples": [
        "button.tsx",
        "input.tsx",
        "badge.tsx",
        "select.tsx"
      ]
    },
    "orientationVariant": {
      "what": "data-[orientation=horizontal]: 를 data-horizontal: 축약 변형으로 쓴다.",
      "why": "app/globals.css 의 @custom-variant 로 정의한 하우스 축약이다. 클래스 문자열이 길어지는 것을 줄인다.",
      "examples": [
        "separator.tsx",
        "tabs.tsx",
        "toggle-group.tsx"
      ]
    },
    "iconSlotConvention": {
      "what": "상류의 has-[>svg] 대신 has-data-[icon=inline-start|inline-end] 를 쓴다.",
      "why": "아이콘 위치에 따라 좌우 패딩을 다르게 보정하기 위해서다. svg 존재 여부만으로는 어느 쪽인지 알 수 없다.",
      "examples": [
        "button.tsx",
        "button-group.tsx"
      ]
    },
    "addedProps": {
      "what": "일부 컴포넌트에 상류에 없는 prop 을 추가했다 (예: card 의 size).",
      "why": "카탈로그가 같은 컴포넌트의 밀도 변형을 보여줘야 한다.",
      "examples": [
        "card.tsx"
      ]
    }
  }
}
