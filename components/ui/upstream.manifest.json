  "_readme": [
    "shadcn 상류 대비 차이 기록 (#48).",
    "components/ui/ 는 '손대지 않은 shadcn 원본' 이 아니라 하우스 스타일이 적용된 포크다.",
    "규칙의 '수정 금지' 는 '임의로 더 고치지 말고, 기록된 차이를 되돌리지도 말라' 는 뜻이다.",
    "customized 인 항목은 groups(체계적 차이 분류) 또는 note(개별 사유) 중 하나를 반드시 갖는다 —",
    "test/shadcn-upstream-manifest.test.ts 가 이를 강제한다.",
    "점검: node scripts/shadcn-upstream.mjs (네트워크 사용, 수동 게이트)",
    "갱신: node scripts/shadcn-upstream.mjs --update  (커스터마이즈가 사라지면 --force 없이는 중단)"
  ],
  "houseStyle": {
    "controlScale": {
      "what": "컨트롤 높이·좌우 패딩을 상류보다 한 단계 작게 쓴다 (버튼 default h-9→h-8, input h-9→h-8, px-3→px-2.5).",
      "why": "#43 의 밀도(density) 축이 이 값을 기준으로 28/32/36px 비례를 계산한다. 상류 값으로 되돌리면 밀도 축 수치가 어긋난다.",
      "examples": [
        "button.tsx",
        "input.tsx",
        "tabs.tsx",
        "toggle.tsx",
        "select.tsx"
      ]
    },
    "radiusTokens": {
      "what": "상류의 고정 rounded-md 대신 --radius 파생 토큰(rounded-lg, rounded-[min(var(--radius-md),12px)] 등)을 쓴다.",
      "why": "#43 의 모서리(corner) 축이 프로필별로 반경을 바꾸려면 컴포넌트가 토큰을 참조해야 한다. 고정값이면 축이 닿지 않는다.",
      "examples": [
        "button.tsx",
        "input.tsx",
        "textarea.tsx",
        "popover.tsx",
        "hover-card.tsx"
      ]
    },
    "semanticTokenSwap": {
      "what": "상류와 다른 시맨틱 색 토큰을 쓴다 (예: skeleton 이 bg-accent 대신 bg-muted).",
      "why": "이 카탈로그의 테마 프리셋에서 대비가 맞는 토큰을 고른 결과다. 하드코딩 색이 아니라 토큰 교체이므로 색 규칙에는 어긋나지 않는다.",
      "examples": [
        "skeleton.tsx",
        "checkbox.tsx",
        "avatar.tsx"
      ]
    },
    "variantShorthand": {
      "what": "긴 속성 선택자를 Tailwind v4 축약 변형으로 쓴다 (data-[orientation=horizontal]: → data-horizontal:, [[data-slot=x]_&]: → in-data-[slot=x]:).",
      "why": "app/globals.css 의 @custom-variant 로 정의한 하우스 축약이다. 클래스 문자열 길이를 줄인다.",
      "examples": [
        "separator.tsx",
        "tabs.tsx",
        "toggle-group.tsx",
        "kbd.tsx"
      ]
    },
    "iconSlotConvention": {
      "what": "상류의 has-[>svg] 대신 has-data-[icon=inline-start|inline-end] 를 쓴다.",
      "why": "아이콘 위치에 따라 좌우 패딩을 다르게 보정하기 위해서다. svg 존재 여부만으로는 어느 쪽인지 알 수 없다.",
      "examples": [
        "button.tsx",
        "button-group.tsx"
      ]
    },
    "addedProps": {
      "what": "상류에 없는 prop 을 추가했다 (card 의 size).",
      "why": "카탈로그가 같은 컴포넌트의 밀도 변형을 실물로 보여줘야 한다.",
      "examples": [
        "card.tsx"
      ]
    },
    "addedAffordance": {
      "what": "상류에 없는 의사요소·슬롯 처리로 기능을 덧댔다 (아바타 테두리 링, 체크박스 히트 영역 확장, 툴팁 안 단축키 슬롯).",
      "why": "접근성과 대비를 보강한 부분이다. 특히 체크박스의 확장된 히트 영역은 작은 컨트롤의 터치 실패를 줄인다.",
      "examples": [
        "avatar.tsx",
        "checkbox.tsx",
        "tooltip.tsx"
      ]
    }
  }
}
